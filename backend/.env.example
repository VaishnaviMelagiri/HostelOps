# Copy to .env and adjust if you need to. Every value here already has a matching default in
# application.yml that lines up with docker-compose.yml, so locally you can run the backend with no
# .env file at all. This file documents what Render will need in Phase 12.
#
# Note: Spring Boot does not read .env files by itself. Either export these into your shell
#   set -a; source .env; set +a
# or just rely on the defaults in application.yml while developing.

# --- Database (must match docker-compose.yml locally) ---
DB_URL=jdbc:postgresql://localhost:5432/hostelops
DB_USERNAME=hostelops
DB_PASSWORD=hostelops

# --- HTTP ---
SERVER_PORT=8080

# Comma-separated list of browser origins allowed to call /api/**.
# Phase 12 adds the deployed Vercel URL here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Added in later phases, listed now so nothing is a surprise ---
# Phase 2 - JWT signing. Must be a long random string; never commit the real one.
#   generate with:  openssl rand -base64 48
# JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=PT15M
#
# Phase 6 - how long a PENDING request survives without an admin decision.
# HOSTELOPS_REQUEST_TTL=PT48H
# HOSTELOPS_EXPIRY_SWEEP_INTERVAL=PT5M
