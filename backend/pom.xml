<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      The Spring Boot "parent POM" is a Maven concept worth understanding early:
      inheriting from it gives us a curated list of dependency versions that are known to work
      together. That is why almost every <dependency> below has no <version> tag - the parent
      already pins one. Upgrading Spring Boot upgrades the whole consistent set at once.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.hostelops</groupId>
    <artifactId>hostelops-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>hostelops-backend</name>
    <description>HostelOps - room allocation and approval system</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- REST controllers + the embedded Tomcat server that serves them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          JPA/Hibernate + a managed DataSource (HikariCP connection pool).
          Phase 1 has no entities yet; this is here so the app owns a real database connection,
          which is what /api/health actually tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- @Valid / @NotNull on DTOs. Unused in Phase 1, needed from Phase 2 onward. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Flyway owns the schema. Hibernate is set to 'validate' and never creates tables, so the
          database shape is always whatever the versioned SQL in db/migration says - reviewable in
          git, identical on every machine. Phase 1 ships zero migrations; V1 arrives in Phase 2.
          Flyway 10+ split each database into its own module, hence the second dependency.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Gives us `./mvnw spring-boot:run` and builds an executable jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
