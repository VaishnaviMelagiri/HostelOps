# Copy to .env.local (which is gitignored) to override.
#
# Vite only exposes variables prefixed with VITE_ to browser code - that prefix is a safety rail,
# not a naming convention. Anything here is bundled into the JavaScript that ships to the browser,
# so a secret must never live in this file. API keys and signing secrets stay on the backend.

# Base URL of the Spring Boot API. Phase 12 points this at the Render URL.
VITE_API_BASE_URL=http://localhost:8080

# Phase 7 - STOMP/WebSocket endpoint.
# VITE_WS_URL=http://localhost:8080/ws

# Phase 2 - show the one-click Student / Admin / Guest demo login buttons.
# VITE_SHOW_DEMO_LOGINS=true
